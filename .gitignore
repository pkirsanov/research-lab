# Canonical data/bars and data/options snapshots are Git-backed publication
# assets so retries and other machines can reuse the same date/window cache.

# Bubbles framework-health proposals (downstream-local)
improvements/

# Feature 005 browser-test generated outputs
# No trailing slash: a trailing slash matches ONLY a directory, so a stray
# `node_modules` SYMLINK slips past it and can be committed by `git add -A`.
/node_modules
/test-results/
/playwright-report/
# The JSON reporter's output, which the red-run owner summary reads. A sibling of the report
# directory above, so the directory rule does not cover it.
/playwright-report.json
/_site/
/.rl-site-*/

# Python bytecode — embeds absolute source paths, so committing it leaks the
# builder's home directory into history
__pycache__/
*.pyc
/.brief-work/

# Code-index provider writes its graph in-repo; never commit it.
.codegraph/

# Transient lock held while a session appends to the state snapshot.
*.flock
