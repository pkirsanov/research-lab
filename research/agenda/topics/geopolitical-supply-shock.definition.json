  "triggers": [
    {
      "triggerId": "transit-restriction-observed",
      "kind": "state-change",
      "description": "A verified restriction or measurable impairment changes a declared route state.",
      "targetIds": [
        "hormuz",
        "bab-el-mandeb",
        "red-sea"
      ],
      "condition": {
        "field": "physicalPassFraction",
        "operator": "changed",
        "value": true
      }
    },
    {
      "triggerId": "insured-capacity-tightens",
      "kind": "threshold",
      "description": "Observed insured effective throughput crosses the declared impairment threshold.",
      "targetIds": [
        "shipping-insurers"
      ],
      "condition": {
        "field": "insuredPassFraction",
        "operator": "below",
        "value": 0.8
      }
    },
    {
      "triggerId": "inventory-response-confirmed",
      "kind": "source-observation",
      "description": "A public inventory or coordinated policy response is confirmed.",
      "targetIds": [
        "oil",
        "refined-products"
      ],
      "condition": {
        "field": "policyResponse",
        "operator": "equals",
        "value": "confirmed"
      }
    }
  ],
  "invalidations": [
    {
      "invalidationId": "transit-normalizes",
      "kind": "state-change",
      "description": "Measured transit and loading return inside the declared normal interval.",
      "targetIds": [
        "hormuz",
        "bab-el-mandeb",
        "red-sea"
      ],
      "condition": {
        "field": "physicalPassFraction",
        "operator": "at-least",
        "value": 0.95
      }
    },
    {
      "invalidationId": "insurance-normalizes",
      "kind": "threshold",
      "description": "Observed insured capacity returns above the declared normalization threshold.",
      "targetIds": [
        "shipping-insurers"
      ],
      "condition": {
        "field": "insuredPassFraction",
        "operator": "at-least",
        "value": 0.95
      }
    },
    {
      "invalidationId": "evidence-stales",
      "kind": "elapsed-cadence",
      "description": "No supporting observation remains inside the evidence freshness window.",
      "targetIds": [
        "source-ledger"
      ],
      "condition": {
        "field": "ageHours",
        "operator": "above",
        "value": 24
      }
    }
  ],
